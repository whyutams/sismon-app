<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".fragment.BerandaFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimVisibleHeightTrigger="110dp"
            app:titleEnabled="false"
            app:toolbarId="@+id/toolbar_beranda">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_brush_header"
                app:layout_collapseMode="parallax"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Orion.HeroHeader" />

            <LinearLayout
                android:id="@+id/ll_profile_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp"
                android:paddingBottom="110dp"
                app:layout_collapseMode="parallax">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        app:contentPadding="-5dp"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:tint="@color/white"
                        tools:src="@drawable/ic_account_circle_24" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Rezaldy S. Umar, S.Pd." />

                    <TextView
                        android:id="@+id/user_jurusan_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        tools:text="Guru RPL" />

                    <TextView
                        android:id="@+id/user_jurusan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        tools:text="Rekayasa Perangkat Lunak" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_beranda"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginTop="36dp"
                android:background="@android:color/transparent"
                android:elevation="100dp"
                android:gravity="center"
                android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
                app:iconTint="@color/white"
                app:layout_collapseMode="pin"
                app:menu="@menu/menu_top_nav"
                app:popupTheme="@style/ThemeOverlay.Material3.Light"
                app:title="Selamat datang Username!"
                app:titleTextColor="@color/white" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:translationY="-85dp">

            <LinearLayout
                android:id="@+id/card_statistik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_outline"
                android:elevation="12dp"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/ll_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/ll_count1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/count1_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="99" />

                        <TextView
                            android:id="@+id/count1_ket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:textAlignment="center"
                            android:textColor="@color/text"
                            android:textSize="10sp"
                            tools:text="Keterangan" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/count_div1"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="32dp"
                        android:background="@color/skeleton"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/ll_count2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/count2_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="99" />

                        <TextView
                            android:id="@+id/count2_ket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:textAlignment="center"
                            android:textColor="@color/text"
                            android:textSize="10sp"
                            tools:text="Keterangan" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/count_div2"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="32dp"
