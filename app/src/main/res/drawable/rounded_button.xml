<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saat tombol ditekan -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/> <!-- Tidak ada background -->
            <stroke
                android:width="2dp"
                android:color="#005D26"/> <!-- Warna hijau lebih gelap -->
            <corners android:radius="50dp"/>
            <padding
                android:left="16dp"
                android:top="8dp"
                android:right="16dp"
                android:bottom="8dp"/>
        </shape>
    </item>

    <!-- Warna normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/> <!-- Tidak ada background -->
            <stroke
                android:width="2dp"
                android:color="#007A33"/> <!-- Warna hijau normal -->
            <corners android:radius="50dp"/>
            <padding
                android:left="16dp"
                android:top="8dp"
                android:right="16dp"
                android:bottom="8dp"/>
        </shape>
    </item>
</selector>
